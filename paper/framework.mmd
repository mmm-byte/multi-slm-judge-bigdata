%% Multi-SLMs-as-Judge with Inter-LLM Deliberation (EXP5)
%% Style: same top-to-bottom flow as the original framework figure.
%% Vertical judge stack, three threshold diamonds, four outcomes.
%% Only addition: the Split/Disagree branch loops through the
%% "Inter-LLM Deliberation" node before reaching human review.
%%
%% Render: https://mermaid.live  ->  Actions -> Export PNG (or SVG)
%% Or from CLI: mmdc -i framework.mmd -o framework.png -w 1000 -H 1200 -b white

flowchart TD
    %% Define style classes
    classDef input_block fill:#ffffff,stroke:#4caf50,stroke-width:1px,stroke-dasharray: 5 5,color:#000000
    classDef inner_input fill:#e8f5e9,stroke:#4caf50,stroke-width:1px,color:#000000
    classDef judges_block fill:#f8f9fa,stroke:#ced4da,stroke-width:1px,rx:5,ry:5,color:#000000
    classDef j_node fill:#ede7f6,stroke:#5e35b1,stroke-width:1px,rx:5,ry:5,color:#000000
    classDef calculation_node fill:#fff8e1,stroke:#ffb300,stroke-width:1px,rx:5,ry:5,color:#000000
    classDef diamond_node fill:#fff8e1,stroke:#ffb300,stroke-width:1px,color:#000000
    classDef delib_node fill:#fbdce8,stroke:#9D174D,stroke-width:1.4px,rx:5,ry:5,color:#000000
    classDef leafy_green fill:#e8f5e9,stroke:#4caf50,stroke-width:1px,rx:5,ry:5,color:#000000
    classDef leafy_red fill:#ffebee,stroke:#e53935,stroke-width:1px,rx:5,ry:5,color:#000000

    %% --- Model Inputs (Horizontal) ---
    subgraph Inputs [" "]
        direction LR
        InputQ["Question q + Answer a"]:::inner_input
        InputR["Rubric R"]:::inner_input
    end
    Inputs:::input_block

    %% --- Judges (Vertical Stack) ---
    subgraph Judges [" "]
        direction TB
        J1["J1"]:::j_node
        J2["J2"]:::j_node
        Jellipses["..."]:::j_node
        J4["J4"]:::j_node
    end
    Judges:::judges_block

    %% --- Process Nodes ---
    PairwiseCalculation["Pairwise Agreement (Agr)<br/>Calculation"]:::calculation_node

    DiamondFA{"Agr >= theta_FA"}:::diamond_node
    QualityScoreGeneration["Quality Score (S)<br/>Generation"]:::calculation_node

    DiamondMA{"Agr >= theta_MA"}:::diamond_node
    DiamondSP{"Agr >= theta_SP"}:::diamond_node

    %% --- EXP5 Inter-LLM Deliberation (new) ------------------------------
    DELIB["Inter-LLM Deliberation (EXP5)<br/>Re-prompt disagreeing<br/>judges with peer<br/>scores and rationales"]:::delib_node

    %% --- Outcomes -------------------------------------------------------
    FullAgreement["Full Agreement<br/>S + Analysis Note"]:::leafy_green
    MajorityAgree["Majority Agree<br/>S + Analysis Note"]:::leafy_green

    SplitPanel["Split Panel<br/>Analysis Note +<br/>Suggest Human Review"]:::leafy_red
    FullDisagree["Full Disagree<br/>Analysis Note +<br/>Trigger Human Review"]:::leafy_red

    %% --- Connections ----------------------------------------------------
    %% Inputs -> Judges (all judges receive all inputs in parallel)
    Inputs --> Judges
    %% Judges -> Pairwise Calculation
    Judges --> PairwiseCalculation
    PairwiseCalculation --> DiamondFA

    %% FA Decision: pass -> Quality Score Generation; fail -> MA diamond
    DiamondFA ==>|yes| QualityScoreGeneration
    DiamondFA -->|no| DiamondMA

    %% MA Decision: pass -> Quality Score Generation; fail -> SP diamond
    DiamondMA ==>|yes| QualityScoreGeneration
    DiamondMA -->|no| DiamondSP

    %% Quality Score Generation -> two green outcomes
    QualityScoreGeneration ==> FullAgreement
    QualityScoreGeneration ==> MajorityAgree

    %% SP Decision: pass -> Split Panel (still leaves room for agreement);
    %% fail -> Full Disagree
    DiamondSP ==>|yes| SplitPanel
    DiamondSP ==>|no| FullDisagree

    %% EXP5: SP and D cases feed into the deliberation node, which
    %% re-prompts the disagreeing judges and loops the revised scores
    %% back into the Pairwise Calculation.
    SplitPanel  -. "SP cases re-prompted" .-> DELIB
    FullDisagree -. "D cases re-prompted"  .-> DELIB
    DELIB -. "revised scores<br/>re-enter Agr" .-> PairwiseCalculation
